# Salin ke backend/.env, isi nilainya, lalu buat symlink di root:
#   cp .env.example backend/.env
#   ln -s backend/.env .env
# JANGAN commit file .env yang sudah terisi.

# OpenAI
OPENAI_API_KEY=

# Qdrant (nama variabelnya QDRANT_API, bukan QDRANT_API_KEY)
QDRANT_URL=
QDRANT_API=
# Pastikan nama collection ini BELUM ada di cluster Qdrant lo
QDRANT_COLLECTION=olist_data_3

# Turso (pakai token --read-only untuk app)
TURSO_DATABASE_URL=
TURSO_DATABASE_TOKEN=

# Langfuse (cek region akun: EU atau US)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Backend: URL frontend (dibaca api/main.py)
FRONTEND_URL=
# Frontend: URL backend untuk run manual
API_URL=http://localhost:8000
